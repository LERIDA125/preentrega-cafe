rules_version = '2';

/**
 * Reglas de Firestore.
 *
 * La UI protege pantallas; esto protege datos. Cualquiera puede leer el
 * catálogo, crear una orden y descontar stock al comprar. Publicar o editar
 * productos y leer órdenes exige sesión iniciada.
 *
 * Para publicarlas: consola de Firebase > Firestore > Reglas, o
 * `firebase deploy --only firestore:rules` con `firebase.json` (ya incluido).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública. Publicar, editar o borrar exige sesión; bajar
    // stock es la única escritura que puede hacer un comprador anónimo.
    match /productos/{id} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || descuentaStock();
    }

    // Órdenes: cualquiera puede comprar, solo el panel las lee.
    // La creación se valida para que nadie escriba basura arbitraria.
    match /orders/{id} {
      allow create: if ordenValida();
      allow read, update, delete: if request.auth != null;
    }

    /**
     * Forma mínima de una orden. No valida importes (no hay pasarela de pago),
     * pero sí que el documento tenga el esquema esperado, que nazca en estado
     * `pendiente` y que la fecha la ponga el servidor.
     */
    function ordenValida() {
      let orden = request.resource.data;

      return orden.keys().hasOnly(['numero', 'buyer', 'items', 'total', 'estado', 'fecha'])
        && orden.numero is string
        && orden.numero.size() > 0
        && orden.numero.size() <= 32
        && orden.estado == 'pendiente'
        && orden.fecha == request.time
        && orden.total is number
        && orden.total >= 0
        && orden.buyer.keys().hasOnly(['nombre', 'email', 'telefono'])
        && orden.buyer.nombre is string
        && orden.buyer.email is string
        && orden.buyer.telefono is string
        && orden.buyer.telefono.size() > 0
        && orden.buyer.telefono.size() <= 30
        && orden.items is list
        && orden.items.size() > 0
        && orden.items.size() <= 50;
    }

    /**
     * Única escritura pública sobre el catálogo: bajar `stock`.
     *
     * El comprador no está autenticado (no hay cuentas de cliente), pero la
     * orden y el descuento son la misma transacción, así que la regla tiene que
     * dejarla pasar. Se acota todo lo que se puede acotar: sólo el campo
     * `stock`, sólo un entero, sólo hacia abajo y nunca por debajo de cero.
     * Cambiar precio, nombre o imagen sigue exigiendo sesión.
     *
     * Límite conocido: un cliente hostil podría bajar stock sin comprar. Eso es
     * griefing, no fraude (no puede subirlo ni cambiar el precio), y es el
     * precio de no tener funciones de servidor. La solución definitiva es una
     * Cloud Function que haga el descuento con privilegios de admin.
     */
    function descuentaStock() {
      let antes = resource.data;
      let despues = request.resource.data;

      return despues.diff(antes).affectedKeys().hasOnly(['stock'])
        && despues.stock is int
        && despues.stock >= 0
        && despues.stock < antes.stock;
    }
  }
}
